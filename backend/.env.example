# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # change to "production" when deploying

# The URL of your deployed frontend (used for CORS)
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173


# ─────────────────────────────────────────────
# Database — PostgreSQL via Neon
# ─────────────────────────────────────────────
# Get this from https://neon.tech → your project → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require


# ─────────────────────────────────────────────
# JWT Configuration
# ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here   # use a long random string in production
JWT_EXPIRES_IN=24h


# ─────────────────────────────────────────────
# Gemini AI
# ─────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash


# ─────────────────────────────────────────────
# Redis (optional — used for caching)
# ─────────────────────────────────────────────
# Leave commented out to disable caching (app still works without it)
# Get a free URL from https://upstash.com
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT


# ─────────────────────────────────────────────
# Email Configuration (Nodemailer)
# ─────────────────────────────────────────────
# Use a Gmail address with an App Password (not your real password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
